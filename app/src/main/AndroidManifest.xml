<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The only permission this app asks for, and only on Android 13+, so it can post the
      morning reminder. Notably absent, and deliberately:
        INTERNET              — the app has no network access of any kind
        SYSTEM_ALERT_WINDOW   — nothing is drawn over other apps
        accessibility service — nothing observes what you do on the phone
      The last two are what made Play Protect warn about the earlier build; they belonged
      to the app-blocking feature, which is gone.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Timebox">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
