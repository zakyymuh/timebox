<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The only permissions this app asks for. Notably absent, and deliberately:
        INTERNET              — the app has no network access of any kind
        SYSTEM_ALERT_WINDOW   — nothing is drawn over other apps
        accessibility service — nothing observes what you do on the phone
      The last two are what made Play Protect warn about an earlier build; they belonged
      to the app-blocking feature, which is gone.

      No exact-alarm permission either: a reminder a few minutes late is fine, so
      it uses an inexact alarm and asks for nothing.

      Today's list and its widget moved to the Habits app; the service log to Motor.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Timebox">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the camera app write one photo into our cache, and a share card be sent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>

        <!-- The 18:00 check for plants that need water. -->
        <receiver
            android:name=".nudge.PlantReceiver"
            android:exported="false" />

        <!-- "Watered" / "Still moist" buttons on the 6pm notification. -->
        <receiver
            android:name=".nudge.PlantActionReceiver"
            android:exported="false" />

        <!-- Alarms do not survive a reboot, so the nudge is re-armed on boot. -->
        <receiver
            android:name=".nudge.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
