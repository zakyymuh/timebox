<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch animation: the bishop's cap turns one rib (72°), so it ends looking exactly
  as it started, while it breathes in slightly. Played once by the system splash screen.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/myriostigma">
    <target android:name="plant">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="900"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:valueFrom="0"
                    android:valueTo="72" />
                <objectAnimator
                    android:duration="450"
                    android:propertyName="scaleX"
                    android:repeatCount="1"
                    android:repeatMode="reverse"
                    android:valueFrom="1"
                    android:valueTo="1.06" />
                <objectAnimator
                    android:duration="450"
                    android:propertyName="scaleY"
                    android:repeatCount="1"
                    android:repeatMode="reverse"
                    android:valueFrom="1"
                    android:valueTo="1.06" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
