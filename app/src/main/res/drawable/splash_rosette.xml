<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch animation: the rosette turns once all the way round (its rings repeat at
  different angles, so only a full turn ends as it started) while it breathes in slightly.
  Played once by the system splash screen, slowly: one turn over 2 s that keeps slowing until it stops.
  MainActivity holds the splash until it ends (keep SPLASH_MS there in step).
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/rosette">
    <target android:name="plant">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="2000"
                    android:interpolator="@android:interpolator/decelerate_cubic"
                    android:propertyName="rotation"
                    android:valueFrom="0"
                    android:valueTo="360" />
                <objectAnimator
                    android:duration="1000"
                    android:propertyName="scaleX"
                    android:repeatCount="1"
                    android:repeatMode="reverse"
                    android:valueFrom="1"
                    android:valueTo="1.06" />
                <objectAnimator
                    android:duration="1000"
                    android:propertyName="scaleY"
                    android:repeatCount="1"
                    android:repeatMode="reverse"
                    android:valueFrom="1"
                    android:valueTo="1.06" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
