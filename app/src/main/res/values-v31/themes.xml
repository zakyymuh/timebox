<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ shows this the instant the app is tapped, before any code runs:
      white page, cream circle, the dusty rose rosette turning once.
    -->
    <style name="Theme.Timebox" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_rosette</item>
        <item name="android:windowSplashScreenAnimationDuration">900</item>
    </style>
</resources>
