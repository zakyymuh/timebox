<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The only permissions this app asks for. No INTERNET: the app has no network access
      of any kind. No exact-alarm permission: a morning reminder a few minutes late is
      fine, so it uses an inexact alarm and asks for nothing.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Habits">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".nudge.MorningReceiver"
            android:exported="false" />

        <!--
          updatePeriodMillis is 0: the widget is refreshed when the list changes, not on
          a timer, because a timer would wake the phone all day to redraw a list that
          usually has not moved.
        -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- Alarms do not survive a reboot, so the morning reminder is re-armed on boot. -->
        <receiver
            android:name=".nudge.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
