<?xml version="1.0" encoding="utf-8"?>
<!--
  Chrome behind the launcher icon: light, a darker band through the middle, light again.
  The gradient runs over 18..90, the part a round launcher shows, with the same stops as
  Chrome in SoulRed.kt, so the launch intro's first frame matches the splash.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="18"
                android:endX="54" android:endY="90"
                android:startColor="#FFF7F8FA"
                android:centerColor="#FFC8CCD2"
                android:endColor="#FFEEF0F3" />
        </aapt:attr>
    </path>
</vector>
